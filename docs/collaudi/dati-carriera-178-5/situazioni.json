🌀 Marca stretta sul lato destro — finta e apri lo spazio!","intro":"","intent":"dribble","acts":["🌀 Sterzata esterna, fuga sul fondo e assist","↗️ Cross immediato di prima","🦵 Tiro verso il palo vicino"]},{"i":178,"type":"off","text":"🏃 Accelerazione sulla fascia — il recupero avversario è lento!","intro":"","intent":"cross","acts":["⚡ Sterzata d'esterno, brucia il terzino e assist","🎯 Cross preciso al secondo palo","🎯 Tiro a giro sul palo lontano"]},{"i":179,"type":"off","text":"↩️ Uno-due in verticale — dai e vai!","intro":"","intent":"onetwo","acts":["↩️ Dai e vai in verticale","⚡ Scatta dopo lo scarico","🔺 Triangolo stretto e servi"]},{"i":180,"type":"off","text":"🔺 Triangolo al limite — combina e concludi!","intro":"","intent":"onetwo","acts":["🔺 Combinazione stretta e tiro","↩️ Scarico e ricevi in area","⚡ Parete e inserimento centrale"]},{"i":181,"type":"off","text":"↔️ Cambio di gioco — ribalta sul lato debole!","intro":"","intent":"switch","acts":["↔️ Lancio diagonale a cambiare fronte","🎯 Apri il gioco sull'esterno smarcato","⚡ Guida e sposta il pallone di lato"]},{"i":182,"type":"off","text":"🔄 Ribaltamento veloce — l'altro lato è sguarnito!","intro":"","intent":"switch","acts":["🔄 Palla lunga a ribaltare l'azione","🎯 Cambio d'ala rasoterra","↗️ Apri largo per la sovrapposizione"]},{"i":183,"type":"def","text":"🧠 Anticipo sulla punta — leggi il passaggio!","intro":"","intent":"anticipate","acts":["🧠 Anticipa il pallone sulla punta","⚡ Esci in pressione sul portatore","↩️ Chiudi la linea e temporeggia"]},{"i":184,"type":"def","text":"✋ Lettura della linea di passaggio — intercetta!","intro":"","intent":"intercept","acts":["✋ Intercetta il filtrante","⚡ Scatta sulla linea di passaggio","🧠 Leggi e taglia il corridoio"]},{"i":185,"type":"off","text":"🔁 Uno-due sull'esterno — riparti in velocità!","intro":"","intent":"onetwo","acts":["🔁 Scarico e ricevi sul fondo","⚡ Parete e sfonda in fascia","🎯 Triangolo veloce e cross"]},{"i":186,"type":"off","text":"👟 Muro di prima e scatto — dai e vai in area!","intro":"","intent":"onetwo","acts":["👟 Appoggio di prima e inserimento","↩️ Sponda corta e ricevi in area","⚡ Uno-due e conclusione al volo"]},{"i":187,"type":"off","text":"🎯 Apertura a scavalcare — l'ala è isolata sul lato debole!","intro":"","intent":"switch","acts":["🎯 Palla filtrante a scavalcare","↔️ Cambio di fronte teso","↗️ Guida e servi l'esterno"]},{"i":188,"type":"off","text":"🔀 Inverti il fronte — sposta il gioco e accelera!","intro":"","intent":"switch","acts":["🔀 Sposta il pallone sul lato opposto","🎯 Diagonale rasoterra a cambiare","⚡ Conduci e allarga per la corsa"]},{"i":189,"type":"def","text":"🧠 Anticipo in copertura — brucia la punta sul tempo!","intro":"","intent":"anticipate","acts":["🧠 Anticipa sul primo controllo","⚡ Esci in pressione e ruba il tempo","↩️ Accorcia e chiudi lo specchio"]},{"i":190,"type":"def","text":"✋ Chiudi il corridoio centrale — leggi lo scambio!","intro":"","intent":"intercept","acts":["✋ Intercetta lo scarico centrale","🧠 Leggi il triangolo e rompi il gioco","⚡ Scatta sul portatore e recupera"]}]