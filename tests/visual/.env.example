# AI VISION REVIEW — configurazione (copia in tests/visual/.env)
# Provider attivo: ollama (1° provider, locale e gratuito) | anthropic | openai | gemini
VISION_PROVIDER=ollama

# Generici (validi per ogni provider)
VISION_MAX_HIGHLIGHTS=6
VISION_MAX_IMAGES=6
VISION_TIMEOUT=60000
VISION_MAX_RETRY=3
VISION_ENABLE_CACHE=true
VISION_LOG_LEVEL=info
# VISION_PROMPT_FILE=./prompts/vision.txt   # opzionale: prompt personalizzato

# --- Modalità di cattura ---
# VISION_MODE=frames   # 'frames' (default): 5 fasi statiche (begin/preparation/main/outcome/post)
# VISION_MODE=video    # 'video': FILMSTRIP ordinato dei fotogrammi della conclusione → l'AI giudica il MOVIMENTO
                       #   (fluidità, continuità traiettoria, tempi esito↔3D, scatti/teleport)
# VISION_VIDEO_FRAMES=10      # quanti fotogrammi nel filmstrip (clamp 3..16)
# VISION_VIDEO_INTERVAL=110   # passo di campionamento in ms tra i frame (floor 40)

# --- Ollama ---
# Locale (default):  OLLAMA_BASE_URL=http://localhost:11434  (nessuna API key)
# Cloud:             OLLAMA_BASE_URL=https://ollama.com  + OLLAMA_API_KEY=<bearer token>
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=          # solo per Ollama Cloud (Bearer); NON committare la chiave reale
OLLAMA_MODEL=qwen2.5vl
OLLAMA_TIMEOUT=60000
OLLAMA_MAX_RETRY=3
OLLAMA_MAX_IMAGES=6
OLLAMA_ENABLE_CACHE=true
OLLAMA_LOG_LEVEL=info

# --- Anthropic (opzionale) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI (predisposto) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Gemini (predisposto) ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash
