{
  "name": "korward-elite",
  "version": "1.0.0",
  "private": true,
  "description": "Korward Elite — Football Career Simulator (packaging Capacitor per Google Play)",
  "scripts": {
    "build:web": "node tools/build-dist.mjs",
    "validate:web": "node tools/validate-dist.mjs",
    "package": "npm run build:web && npx cap sync android",
    "assets:gen": "node tools/gen-assets.mjs",
    "assets:android": "npx capacitor-assets generate --assetPath resources --android",
    "android:open": "npx cap open android",
    "android:aab": "node tools/gradle.mjs bundleRelease",
    "android:apk": "node tools/gradle.mjs assembleDebug"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3"
  }
}
