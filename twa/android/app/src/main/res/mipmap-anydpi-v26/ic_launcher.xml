<?xml version="1.0" encoding="utf-8"?>
<!-- Icona adattiva (Android 8+): il sistema la ritaglia (cerchio, goccia, quadrato). Il primo piano e' resources/icon-foreground.png
     ridotto: il disegno sta entro il 28% del lato dal centro, dentro il cerchio visibile del 33% (72 dp su 108). L'icona
     "maskable" del sito (34%) qui sarebbe stata ritagliata — il difetto dei primi giorni di PLINTO. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
